# Database — SQLite (dev) or PostgreSQL (production)
# SQLite: sqlite:///./data/cvision.db
# PostgreSQL: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=sqlite:///./data/cvision.db

# Auth (reset/verify secrets default to AUTH_JWT_SECRET if left blank)
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_JWT_LIFETIME_SECONDS=3600
AUTH_RESET_TOKEN_SECRET=
AUTH_VERIFICATION_TOKEN_SECRET=

# LLM API Keys
GROQ_API_KEY=gsk_your_groq_api_key
OPENAI_API_KEY=sk-your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
TAVILY_API_KEY=tvly-your_tavily_api_key

# LLM Models
GROQ_MODEL_LARGE=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# FAISS
FAISS_ALLOW_DANGEROUS=False
FAISS_INDEX_PATH=Data/faiss_db

# CORS (comma-separated origins; * allows all)
CORS_ORIGINS=*

# Monitoring (leave blank if not using)
SENTRY_DSN=

# Headless browser (for LinkedIn scraping)
CHROME_BROWSER_PATH=
LINKEDIN_LOCATION=Egypt

# Scrolling behaviour (LinkedIn scraping)
SCROLL_PAUSE_SECONDS=5
MAX_SCROLLS=25
FINAL_WAIT_SECONDS=30
