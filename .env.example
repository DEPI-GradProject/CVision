# Database — PostgreSQL (Neon, RDS, etc.)
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Auth
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_JWT_LIFETIME_SECONDS=3600

# LLM API Keys
GROQ_API_KEY=gsk_your_groq_api_key
OPENAI_API_KEY=sk-your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
TAVILY_API_KEY=tvly-your_tavily_api_key

# LLM Models
GROQ_MODEL_LARGE=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_FAST=llama-3.1-8b-instant

# FAISS
FAISS_ALLOW_DANGEROUS=False
FAISS_INDEX_PATH=Data/faiss_db

# CORS (comma-separated origins; * allows all)
CORS_ORIGINS=*

# Monitoring (leave blank if not using)
SENTRY_DSN=
