# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Frontend (used at build time — set to the public backend URL, e.g. https://cvision-api.example.com)
VITE_API_URL=

# LLM API Keys (for AI Agents)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# Monitoring (optional)
SENTRY_DSN=

# Auth
AUTH_JWT_SECRET=change-me-to-a-random-secret-string
AUTH_JWT_LIFETIME_SECONDS=3600

# FAISS
FAISS_INDEX_PATH=Data/faiss_db
FAISS_ALLOW_DANGEROUS=false

# LinkedIn Scraper (optional)
CHROME_BROWSER_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
LINKEDIN_LOCATION=Egypt
SCROLL_PAUSE_SECONDS=5
MAX_SCROLLS=25
FINAL_WAIT_SECONDS=30
